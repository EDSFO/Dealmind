# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Database - Supabase PostgreSQL
# Get DATABASE_URL from: Supabase Dashboard → Project Settings → Database → Connection pooling (Session mode)
# IMPORTANT: Use Session Pooler for IPv4 compatibility (aws-1 region)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase Configuration
# Get these values from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Asaas API Configuration (Sandbox)
ASAAS_API_KEY=your-asaas-api-key-here

# OpenAI Configuration (for conversation analysis - replaces N8N)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# N8N Configuration (optional - only needed if using N8N for orchestration)
# N8N_WEBHOOK_URL="https://your-n8n.com/webhook/dealmind-conversation"
# N8N_WEBHOOK_SECRET="your-random-secret-key-min-32-chars"
# Public URL for N8N callbacks (required when N8N is remote/not on localhost)
# Use ngrok, localtunnel, or your public IP/domain
# Get a free tunnel: https://ngrok.com/signup then run: ngrok http 3000
# APP_PUBLIC_URL="https://xxxx.ngrok-free.app"
